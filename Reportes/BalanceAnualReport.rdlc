                              <TextRuns>
                                <TextRun>
                                  <Value>=IIf(Fields!Diminutivo.Value = "Rentabilidad", "",
	IIf(Fields!Diminutivo.Value = "Actividad", "", 
		IIf(Fields!Diminutivo.Value = "Endeudamiento", "",
			IIf(Fields!Diminutivo.Value = "Viabilidad y Solvencia", "", 
				IIf(Fields!post.Value = "%", 
					IIf(Fields!Valor.Value = "0",
						Replace(Replace(Replace(Replace(Replace(Replace(Replace(Replace(Replace(Fields!Valor.Value,",","*"),".",","),"*","."),"($","-"),")",""),"$",""),".","*"),",","."),"*",",") &amp; "" &amp; Fields!post.Value,
						Replace(Replace(Replace(Replace(Replace(Replace(Replace(Replace(Replace(Fields!Valor.Value,",","*"),".",","),"*","."),"($","-"),"",""),"$",""),".","*"),",","."),"*",",") &amp; "" &amp; Fields!post.Value
					),
					IIf((Fields!Diminutivo.Value = "Rotación Cartera") OrElse (Fields!Diminutivo.Value = "Rotación Inventario") OrElse (Fields!Diminutivo.Value = "Ciclo Operativo") OrElse (Fields!Diminutivo.Value = "Rotación Proveedores"),
						Replace(Replace(Replace(Replace(FormatCurrency(Fields!Valor.Value,0),"€",""),",","."),"($","("),"$",""),
						Replace(Replace(Replace(Replace(Replace(Replace(Replace(Replace(Replace(Fields!Valor.Value,",","*"),".",","),"*","."),"($","-"),")",""),"$",""),".","*"),",","."),"*",",")&amp; "" &amp; Fields!post.Value
					)	
				)
			)
		)
	)
)</Value>
