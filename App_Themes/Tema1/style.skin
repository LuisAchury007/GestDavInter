 <asp:GridView  runat="server" BackColor="White" BorderColor="Black" BorderWidth="1px"
                    CellPadding="2" ForeColor="Black" GridLines="Vertical" Height="100%"  Width="100%"  Font-Names="Arial" Font-Size="12px">
                    <FooterStyle BackColor="LightGray" ForeColor="Black" />
                    <SelectedRowStyle BackColor="DarkSlateBlue" ForeColor="GhostWhite" />
                    <PagerStyle BackColor="White" ForeColor="RoyalBlue" HorizontalAlign="Left" />
                    <HeaderStyle BackColor="Gainsboro" Font-Bold="True" />
                    <AlternatingRowStyle BackColor="White" />
                    <RowStyle BackColor="#EEEEEE" ForeColor="Black" />
</asp:GridView>


 
